          "raw": "{\n  \"tipoResiduo\": \"PLASTICO\",\n  \"cantidad\": 2.5,\n  \"unidadMedida\": \"kg\",\n  \"fecha\": \"2026-09-10\",\n  \"descripcion\": \"Botellas limpias\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/residuos",
