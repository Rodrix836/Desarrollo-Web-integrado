          "raw": "{\n  \"tipoResiduo\": \"PAPEL_CARTON\",\n  \"cantidad\": 3,\n  \"unidadMedida\": \"kg\",\n  \"fecha\": \"2026-09-10\",\n  \"descripcion\": \"Cajas limpias\"\n}"
        },
        "url": {
