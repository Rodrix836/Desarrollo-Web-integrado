@baseUrl = http://localhost:8081

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "prueba",
  "password": "prueba123",
  "nombre": "Usuario de prueba"
}

### Login ADMIN
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

@token = {{login.response.body.$.token}}

### /me
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Listar usuarios (ADMIN)
GET {{baseUrl}}/api/usuarios
Authorization: Bearer {{token}}

### Cambiar rol
PUT {{baseUrl}}/api/usuarios/3/rol
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "ADMIN"
}
### Renovar token
POST {{baseUrl}}/api/auth/refresh
Authorization: Bearer {{token}}

### Editar nombre de un usuario (ADMIN)
PUT {{baseUrl}}/api/usuarios/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Usuario editado"
}

### Desactivar / activar cuenta (ADMIN)
PUT {{baseUrl}}/api/usuarios/2/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "activo": false
}

### Eliminar cuenta (ADMIN)
DELETE {{baseUrl}}/api/usuarios/2
Authorization: Bearer {{token}}

### Cambiar mi contraseña
PUT {{baseUrl}}/api/auth/me/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actual": "admin123",
  "nueva": "admin1234"
}
